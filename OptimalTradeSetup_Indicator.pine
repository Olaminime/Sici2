//@version=5
indicator("Optimal Trade Setup Indicator", overlay=true, max_boxes_count=500, max_lines_count=500)

// ============================================================================
// STRATEGY DESCRIPTION
// ============================================================================
// This indicator combines multiple proven trading concepts:
// 1. Trend Analysis: EMA crossover system (20/50/200 EMAs)
// 2. Momentum: RSI for overbought/oversold conditions
// 3. Smart Money Concepts: Swing high/low for support/resistance
// 4. Volume Confirmation: Above-average volume for valid signals
// 5. Risk Management: Dynamic ATR-based SL/TP with minimum 1:2 RR ratio
//
// ENTRY RULES:
// Long: Fast EMA > Slow EMA, RSI oversold recovery, price near support, volume confirmation
// Short: Fast EMA < Slow EMA, RSI overbought rejection, price near resistance, volume confirmation

// ============================================================================
// INPUT PARAMETERS
// ============================================================================

// Trend Settings
emaFastLength = input.int(20, "Fast EMA Length", minval=1, group="Trend Settings")
emaSlowLength = input.int(50, "Slow EMA Length", minval=1, group="Trend Settings")
emaTrendLength = input.int(200, "Trend EMA Length", minval=1, group="Trend Settings")

// Momentum Settings
rsiLength = input.int(14, "RSI Length", minval=1, group="Momentum Settings")
rsiOverbought = input.float(70, "RSI Overbought Level", minval=50, maxval=100, group="Momentum Settings")
rsiOversold = input.float(30, "RSI Oversold Level", minval=0, maxval=50, group="Momentum Settings")

// Support/Resistance Settings
swingLookback = input.int(10, "Swing Lookback Period", minval=2, group="S/R Settings")

// Volume Settings
volumeMALength = input.int(20, "Volume MA Length", minval=1, group="Volume Settings")
volumeMultiplier = input.float(1.2, "Volume Multiplier", minval=1.0, step=0.1, group="Volume Settings")

// Risk Management Settings
atrLength = input.int(14, "ATR Length", minval=1, group="Risk Management")
atrMultiplierSL = input.float(1.5, "ATR Multiplier for Stop Loss", minval=0.5, step=0.1, group="Risk Management")
riskRewardRatio = input.float(2.0, "Risk:Reward Ratio", minval=1.0, step=0.1, group="Risk Management")

// Visual Settings
showEMAs = input.bool(true, "Show EMAs", group="Visual Settings")
showSignals = input.bool(true, "Show Entry Signals", group="Visual Settings")
longBoxColor = input.color(color.new(color.green, 85), "Long Position Box Color", group="Visual Settings")
shortBoxColor = input.color(color.new(color.red, 85), "Short Position Box Color", group="Visual Settings")
longBorderColor = input.color(color.green, "Long Box Border Color", group="Visual Settings")
shortBorderColor = input.color(color.red, "Short Box Border Color", group="Visual Settings")

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

// EMA Calculations
emaFast = ta.ema(close, emaFastLength)
emaSlow = ta.ema(close, emaSlowLength)
emaTrend = ta.ema(close, emaTrendLength)

// RSI Calculation
rsi = ta.rsi(close, rsiLength)

// ATR Calculation for dynamic SL/TP
atr = ta.atr(atrLength)

// Volume Analysis
volumeMA = ta.sma(volume, volumeMALength)
volumeCondition = volume > volumeMA * volumeMultiplier

// Swing High/Low for Support/Resistance
swingHigh = ta.highest(high, swingLookback)
swingLow = ta.lowest(low, swingLookback)

// ============================================================================
// TREND DETECTION
// ============================================================================

// Bullish Trend: Fast EMA > Slow EMA and price > Trend EMA
bullishTrend = emaFast > emaSlow and close > emaTrend

// Bearish Trend: Fast EMA < Slow EMA and price < Trend EMA
bearishTrend = emaFast < emaSlow and close < emaTrend

// ============================================================================
// MOMENTUM CONDITIONS
// ============================================================================

// RSI oversold recovery (for longs): RSI was below oversold and now recovering
rsiOversoldRecovery = rsi[1] < rsiOversold and rsi > rsi[1]

// RSI overbought rejection (for shorts): RSI was above overbought and now declining
rsiOverboughtRejection = rsi[1] > rsiOverbought and rsi < rsi[1]

// ============================================================================
// SUPPORT/RESISTANCE PROXIMITY
// ============================================================================

// Price near support (within 0.5% of swing low)
nearSupport = close <= swingLow * 1.005 and close >= swingLow * 0.995

// Price near resistance (within 0.5% of swing high)
nearResistance = close >= swingHigh * 0.995 and close <= swingHigh * 1.005

// ============================================================================
// ENTRY SIGNAL LOGIC
// ============================================================================

// Long Entry Conditions
longCondition = bullishTrend and rsiOversoldRecovery and volumeCondition and nearSupport

// Short Entry Conditions
shortCondition = bearishTrend and rsiOverboughtRejection and volumeCondition and nearResistance

// Track if signal is new (only on bar close)
var bool lastWasLong = false
var bool lastWasShort = false

newLongSignal = longCondition and not lastWasLong
newShortSignal = shortCondition and not lastWasShort

// Update tracking
if newLongSignal
    lastWasLong := true
    lastWasShort := false
else if newShortSignal
    lastWasShort := true
    lastWasLong := false
else if not longCondition
    lastWasLong := false
else if not shortCondition
    lastWasShort := false

// ============================================================================
// POSITION BOXES WITH SL AND TP
// ============================================================================

// Calculate Stop Loss and Take Profit for Long Positions
longEntry = close
longStopLoss = longEntry - (atr * atrMultiplierSL)
longRisk = longEntry - longStopLoss
longTakeProfit = longEntry + (longRisk * riskRewardRatio)

// Calculate Stop Loss and Take Profit for Short Positions
shortEntry = close
shortStopLoss = shortEntry + (atr * atrMultiplierSL)
shortRisk = shortStopLoss - shortEntry
shortTakeProfit = shortEntry - (shortRisk * riskRewardRatio)

// Draw Long Position Box
if newLongSignal
    // Entry to Take Profit Box (Green - Target Zone)
    longText = "LONG\nEntry: " + str.tostring(longEntry, "#.##") + "\nTP: " + str.tostring(longTakeProfit, "#.##") + "\nRR: 1:" + str.tostring(riskRewardRatio, "#.#")
    box.new(bar_index, longTakeProfit, bar_index + 20, longEntry, border_color=longBorderColor, bgcolor=longBoxColor, border_width=2, text=longText, text_color=color.green, text_halign=text.align_left, text_valign=text.align_top, text_size=size.small)
    
    // Entry to Stop Loss Box (Red - Risk Zone)
    longSLText = "SL: " + str.tostring(longStopLoss, "#.##")
    box.new(bar_index, longEntry, bar_index + 20, longStopLoss, border_color=color.red, bgcolor=color.new(color.red, 90), border_width=1, text=longSLText, text_color=color.red, text_halign=text.align_left, text_valign=text.align_bottom, text_size=size.small)
    
    // Entry Line
    line.new(bar_index, longEntry, bar_index + 20, longEntry, color=color.green, width=2, style=line.style_solid)

// Draw Short Position Box
if newShortSignal
    // Entry to Take Profit Box (Red - Target Zone)
    shortText = "SHORT\nEntry: " + str.tostring(shortEntry, "#.##") + "\nTP: " + str.tostring(shortTakeProfit, "#.##") + "\nRR: 1:" + str.tostring(riskRewardRatio, "#.#")
    box.new(bar_index, shortEntry, bar_index + 20, shortTakeProfit, border_color=shortBorderColor, bgcolor=shortBoxColor, border_width=2, text=shortText, text_color=color.red, text_halign=text.align_left, text_valign=text.align_bottom, text_size=size.small)
    
    // Entry to Stop Loss Box (Red - Risk Zone)
    shortSLText = "SL: " + str.tostring(shortStopLoss, "#.##")
    box.new(bar_index, shortStopLoss, bar_index + 20, shortEntry, border_color=color.red, bgcolor=color.new(color.red, 90), border_width=1, text=shortSLText, text_color=color.red, text_halign=text.align_left, text_valign=text.align_top, text_size=size.small)
    
    // Entry Line
    line.new(bar_index, shortEntry, bar_index + 20, shortEntry, color=color.red, width=2, style=line.style_solid)

// ============================================================================
// VISUAL SIGNALS AND ALERTS
// ============================================================================

// Plot EMAs
plot(showEMAs ? emaFast : na, "Fast EMA", color=color.blue, linewidth=2)
plot(showEMAs ? emaSlow : na, "Slow EMA", color=color.orange, linewidth=2)
plot(showEMAs ? emaTrend : na, "Trend EMA", color=color.purple, linewidth=3)

// Plot Entry Signals
plotshape(showSignals and newLongSignal, "Long Signal", shape.labelup, location.belowbar, color=color.green, text="LONG", textcolor=color.white, size=size.normal)
plotshape(showSignals and newShortSignal, "Short Signal", shape.labeldown, location.abovebar, color=color.red, text="SHORT", textcolor=color.white, size=size.normal)

// Background color for trend
bgcolor(bullishTrend ? color.new(color.green, 95) : bearishTrend ? color.new(color.red, 95) : na, title="Trend Background")

// ============================================================================
// ALERTS
// ============================================================================

// Alert conditions
alertcondition(newLongSignal, title="Long Setup Detected", message="LONG Trade Setup Detected! Check the chart for Entry, SL, and TP levels.")

alertcondition(newShortSignal, title="Short Setup Detected", message="SHORT Trade Setup Detected! Check the chart for Entry, SL, and TP levels.")

// ============================================================================
// INFORMATION TABLE (Optional Dashboard)
// ============================================================================

// Create info table
var table infoTable = table.new(position.top_right, 2, 6, border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1)

// Update table on last bar
if barstate.islast
    table.cell(infoTable, 0, 0, "Metric", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "Value", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 1, "Trend", text_size=size.small)
    table.cell(infoTable, 1, 1, bullishTrend ? "BULLISH" : bearishTrend ? "BEARISH" : "NEUTRAL", bgcolor=bullishTrend ? color.new(color.green, 70) : bearishTrend ? color.new(color.red, 70) : color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 2, "RSI", text_size=size.small)
    table.cell(infoTable, 1, 2, str.tostring(rsi, "#.##"), bgcolor=rsi > rsiOverbought ? color.new(color.red, 70) : rsi < rsiOversold ? color.new(color.green, 70) : color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 3, "Volume", text_size=size.small)
    table.cell(infoTable, 1, 3, volumeCondition ? "HIGH" : "NORMAL", bgcolor=volumeCondition ? color.new(color.blue, 70) : color.new(color.gray, 70), text_color=color.white, text_size=size.small)
    
    table.cell(infoTable, 0, 4, "ATR", text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(atr, "#.####"), text_size=size.small)
    
    table.cell(infoTable, 0, 5, "RR Ratio", text_size=size.small)
    table.cell(infoTable, 1, 5, "1:" + str.tostring(riskRewardRatio, "#.#"), bgcolor=color.new(color.blue, 70), text_color=color.white, text_size=size.small)

// ============================================================================
// END OF INDICATOR
// ============================================================================
